# =============================================================================
# GlitchTip — Environment Variables
# =============================================================================
# Usage: docker compose -f docker/glitchtip/docker-compose.yml up -d
# =============================================================================

# Django secret key — generate a random 50+ char string:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
GLITCHTIP_SECRET_KEY=change-me-to-a-random-secret

# ─────────────────────────────────────────────────────────────────────────────
# Post-Setup: after GlitchTip is running at http://localhost:8000
#
# 1. Create an admin account and organization
# 2. Create project "pfm-backend" (NestJS) → copy SENTRY_DSN to backend/.env
# 3. Create project "pfm-frontend" (React)  → copy VITE_SENTRY_DSN to frontend/.env
# ─────────────────────────────────────────────────────────────────────────────
# backend/.env:  SENTRY_DSN=http://<public_key>@localhost:8000/<project_id>
# frontend/.env: VITE_SENTRY_DSN=http://<public_key>@localhost:8000/<project_id>
# =============================================================================
